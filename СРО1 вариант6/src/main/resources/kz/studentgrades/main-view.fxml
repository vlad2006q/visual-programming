<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.studentgrades.controller.MainController" prefWidth="1050" prefHeight="650">
 <top><VBox spacing="6"><MenuBar><menus><Menu text="Файл"><items><MenuItem text="Добавить" onAction="#add" accelerator="Ctrl+N"/><MenuItem text="Сохранить" onAction="#save" accelerator="Ctrl+S"/><SeparatorMenuItem/><MenuItem text="Выход" onAction="#exit"/></items></Menu><Menu text="Правка"><items><MenuItem text="Изменить" onAction="#edit"/><MenuItem text="Удалить" onAction="#delete" accelerator="DELETE"/></items></Menu><Menu text="Справка"><items><MenuItem text="О программе" onAction="#showAbout"/></items></Menu></menus></MenuBar><ToolBar><Button text="＋ Добавить" onAction="#add"/><Button text="Изменить" onAction="#edit"/><Button text="Удалить" onAction="#delete"/><Separator/><Label text="Журнал оценок студентов" styleClass="toolbar-title"/></ToolBar></VBox></top>
 <center><VBox spacing="12" styleClass="content-panel"><HBox spacing="10"><TextField fx:id="searchField" promptText="Поиск по студенту или дисциплине..." HBox.hgrow="ALWAYS"/><ComboBox fx:id="groupFilter" prefWidth="160"/><ComboBox fx:id="subjectFilter" prefWidth="180"/></HBox><TableView fx:id="gradeTable" VBox.vgrow="ALWAYS" columnResizePolicy="CONSTRAINED_RESIZE_POLICY"><columns><TableColumn fx:id="studentColumn" text="Студент" prefWidth="240"/><TableColumn fx:id="groupColumn" text="Группа" prefWidth="120"/><TableColumn fx:id="subjectColumn" text="Дисциплина" prefWidth="190"/><TableColumn fx:id="scoreColumn" text="Баллы" prefWidth="90"/><TableColumn fx:id="resultColumn" text="Результат" prefWidth="180"/></columns></TableView><HBox alignment="CENTER_RIGHT"><Label fx:id="averageLabel" text="Средний балл: 0.00" styleClass="average-label"/></HBox></VBox></center>
 <bottom><HBox styleClass="status-bar"><Label fx:id="statusLabel" text="Готово"/></HBox></bottom>
</BorderPane>
